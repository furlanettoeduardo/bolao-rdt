// Bolão da Copa do Mundo FIFA 2026 — modelo de dados
// Postgres (Neon) + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Variáveis criadas automaticamente pela integração Neon ↔ Vercel:
  //   POSTGRES_PRISMA_URL   → conexão COM pooler, já no formato do Prisma
  //                           (inclui pgbouncer=true — evita erro de prepared statement)
  //   DATABASE_URL_UNPOOLED → conexão DIRETA (sem pooler), usada por `prisma migrate`
  // Em dev local, defina as duas com a sua connection string (podem ser iguais).
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  USER
  ADMIN
}

enum Stage {
  GROUP // Fase de grupos
  ROUND_32 // 16 avos de final (fase de 32)
  ROUND_16 // Oitavas de final
  QUARTER // Quartas de final
  SEMI // Semifinais
  THIRD_PLACE // Disputa de 3º lugar
  FINAL // Final
}

enum MatchStatus {
  SCHEDULED
  IN_PLAY
  PAUSED
  FINISHED
  SUSPENDED
  POSTPONED
  CANCELLED
  AWARDED // W.O. — tratado como finalizado
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  predictions  Prediction[]
  championPick ChampionPick?
  pointAdjustments PointAdjustment[]
  notifications    Notification[]
  // Última posição conhecida no ranking — usada para detectar mudanças e notificar
  lastRankingPosition Int?
}

model Team {
  id         String  @id @default(cuid())
  externalId Int     @unique
  name       String
  code       String // sigla (TLA), ex.: BRA
  flagUrl    String
  group      String? // "A".."L"

  homeMatches      Match[]        @relation("HomeTeam")
  awayMatches      Match[]        @relation("AwayTeam")
  penaltyWins      Match[]        @relation("PenaltyWinner")
  advancedMatches  Match[]        @relation("AdvancingTeam")
  predictions      Prediction[]   @relation("PredictedAdvancing")
  championPicks    ChampionPick[]
  standings        GroupStanding[]
}

model Match {
  id         String      @id @default(cuid())
  externalId Int         @unique
  stage      Stage
  group      String? // "A".."L" (apenas fase de grupos)
  matchday   Int?
  kickoff    DateTime // sempre UTC
  status     MatchStatus @default(SCHEDULED)

  homeTeamId      String?
  awayTeamId      String?
  homePlaceholder String? // ex.: "1º do Grupo A" enquanto o time não é definido
  awayPlaceholder String?

  // Placar do tempo regulamentar (90 min) — base da pontuação
  homeScore Int?
  awayScore Int?
  // Placar acumulado após a prorrogação (120 min), quando houver
  homeScoreET Int?
  awayScoreET Int?
  // Pênaltis, quando houver
  homePenalties Int?
  awayPenalties Int?

  penaltyWinnerTeamId String?
  advancingTeamId     String? // quem avançou (mata-mata), seja qual for a forma de decisão

  venue     String?
  city      String?
  referee   String? // nome do árbitro principal, quando a API informar

  // Cronômetro interno do jogo ao vivo (NÃO vem da API): início do segmento em
  // andamento e minutos já acumulados antes dele. Congela no intervalo e
  // recomeça quando o jogo volta a ficar ao vivo. O minuto é calculado no
  // cliente a partir destes dois campos.
  liveSegmentStart DateTime?
  clockBaseMinutes Int?

  updatedAt DateTime @updatedAt

  homeTeam      Team? @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      Team? @relation("AwayTeam", fields: [awayTeamId], references: [id])
  penaltyWinner Team? @relation("PenaltyWinner", fields: [penaltyWinnerTeamId], references: [id])
  advancingTeam Team? @relation("AdvancingTeam", fields: [advancingTeamId], references: [id])

  predictions Prediction[]
  goals       MatchGoal[]

  @@index([kickoff])
  @@index([status])
  @@index([stage, group])
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  // Obrigatório no mata-mata quando o palpite é empate; caso contrário, inferido do placar
  advancingTeamId String?
  points          Int? // null = ainda não pontuado (cálculo automático)
  // Pontos definidos manualmente pelo admin; quando != null, prevalece sobre
  // `points` e NÃO é recalculado por syncs nem por edição de resultado.
  pointsOverride  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match         Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  advancingTeam Team? @relation("PredictedAdvancing", fields: [advancingTeamId], references: [id])

  @@unique([userId, matchId])
  @@index([matchId])
}

model ChampionPick {
  id        String   @id @default(cuid())
  userId    String   @unique
  teamId    String
  points    Int? // creditado ao final do torneio
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id])
}

// Gol detectado pela mudança de placar no sync. O autor não é gravado (a API
// gratuita não fornece); o minuto é estimado pelo cronômetro interno.
model MatchGoal {
  id        String   @id @default(cuid())
  matchId   String
  side      String // "HOME" | "AWAY"
  minute    Int? // estimado; null se o gol foi detectado com o jogo já finalizado
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

model GroupStanding {
  id             String   @id @default(cuid())
  group          String // "A".."L"
  teamId         String
  position       Int
  played         Int
  won            Int
  drawn          Int
  lost           Int
  goalsFor       Int
  goalsAgainst   Int
  goalDifference Int
  points         Int
  updatedAt      DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([group, teamId])
}

model SyncLog {
  id         String   @id @default(cuid())
  ranAt      DateTime @default(now())
  ok         Boolean
  scope      String // "window" | "full" | "manual" | "rescore"
  message    String
  durationMs Int?
}

// Notificação por usuário (sino do header). Gerada pelo sync de forma idempotente
// via `key` única por usuário (o sync roda a cada minuto). Tipos: brazil_soon,
// match_finished, prediction_result, goal, ranking, champion.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  key       String // dedupe por usuário (ex.: "result:<matchId>", "goal:<matchId>:<total>")
  type      String
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, read])
  @@index([userId, createdAt])
}

// Ajuste manual de pontos por usuário (bônus/penalidade do admin). Cada
// lançamento soma `delta` (pode ser negativo) ao total do usuário no ranking
// geral — independente dos palpites. Mantém histórico e motivo.
model PointAdjustment {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
