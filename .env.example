# ─────────────────────────────────────────────────────────────────────────────
# Bolão da Copa 2026 — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (Neon). Os nomes abaixo são os criados pela integração nativa
# Neon <-> Vercel — em produção eles já vêm preenchidos automaticamente.
#
# POSTGRES_PRISMA_URL: conexão COM pooler, já no formato do Prisma (pgbouncer=true).
#                      É a que o app usa em runtime (datasource.url).
POSTGRES_PRISMA_URL="postgresql://usuario:senha@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# DATABASE_URL_UNPOOLED: conexão DIRETA (sem pooler) — usada por `prisma migrate`
#                        (datasource.directUrl). Em dev local pode ser igual à de cima.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Segredo de sessão do Auth.js. Gere com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Token gratuito da Football-Data.org (https://www.football-data.org/client/register)
FOOTBALL_DATA_TOKEN="seu-token"

# Segredo que protege POST/GET /api/cron/sync (header Authorization: Bearer <CRON_SECRET>)
# Na Vercel, o cron nativo envia esse header automaticamente quando a env existe.
CRON_SECRET="troque-por-outro-segredo-aleatorio"

# Opcional: se definido, o cadastro exige este código de acesso (bolão fechado)
REGISTRATION_CODE=""

# Opcional: o usuário cadastrado com este email vira ADMIN automaticamente
ADMIN_EMAIL=""

# URL pública da aplicação (sem barra final). Ex.: https://bolao-rdt.vercel.app
# Usada para montar o link do e-mail de "Esqueceu sua senha?". Se não definida,
# cai para VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL na Vercel; defina mesmo assim
# (domínio próprio melhora entregabilidade e confiança do link).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# E-mail transacional (Gmail via SMTP) — usado no fluxo "Esqueceu sua senha?".
# Requer uma conta Gmail com verificação em 2 etapas e uma "Senha de app"
# (https://myaccount.google.com/apppasswords). SEM essas variáveis, em dev o
# link de redefinição é apenas LOGADO no console (o fluxo continua funcionando).
GMAIL_USER="seubolao@gmail.com"
GMAIL_APP_PASSWORD="senha-de-app-de-16-caracteres"
# Opcional: nome de exibição do remetente. O Gmail força o endereço para a conta
# autenticada, então mantenha o e-mail igual ao GMAIL_USER.
EMAIL_FROM="Bolão RDT <seubolao@gmail.com>"
