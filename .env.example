# ─────────────────────────────────────────────────────────────────────────────
# Bolão da Copa 2026 — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (Neon). Use a connection string COM POOLING (pgbouncer) aqui.
# Na integração nativa Neon ↔ Vercel, é a variável DATABASE_URL gerada.
DATABASE_URL="postgresql://usuario:senha@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Connection string DIRETA (sem pooling) — usada apenas por `prisma migrate`.
# No Neon é a mesma URL sem o sufixo "-pooler". Em dev local pode ser igual à de cima.
DIRECT_URL="postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Segredo de sessão do Auth.js. Gere com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Token gratuito da Football-Data.org (https://www.football-data.org/client/register)
FOOTBALL_DATA_TOKEN="seu-token"

# Segredo que protege POST/GET /api/cron/sync (header Authorization: Bearer <CRON_SECRET>)
# Na Vercel, o cron nativo envia esse header automaticamente quando a env existe.
CRON_SECRET="troque-por-outro-segredo-aleatorio"

# Opcional: se definido, o cadastro exige este código de acesso (bolão fechado)
REGISTRATION_CODE=""

# Opcional: o usuário cadastrado com este email vira ADMIN automaticamente
ADMIN_EMAIL=""

# URL pública da aplicação (sem barra final). Ex.: https://bolao-rdt.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
